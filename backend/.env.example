PORT=3000

# Supabase Postgres (Project Settings → Database)
# DATABASE_URL = Transaction pooler (port 6543) — used by the NestJS app at runtime
# DIRECT_URL   = Direct connection (port 5432) — used by Prisma migrate / seed
#
# Dashboard → Connect → ORMs → Prisma shows both URLs.
# Replace [PASSWORD] and host values with your project’s.

DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Comma-separated Google emails that become admin on first login
ADMIN_EMAILS=
